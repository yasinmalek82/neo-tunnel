[Unit]
Description=NEO authenticated HTTP/2 forward proxy
PartOf=neo-frp@frps-naive.service
After=network-online.target

[Service]
Type=simple
Slice=neo-naive.slice
User=neo
Group=neo
StateDirectory=neo-tunnel/caddy
Environment=XDG_DATA_HOME=/var/lib/neo-tunnel/caddy
Environment=XDG_CONFIG_HOME=/var/lib/neo-tunnel/caddy
EnvironmentFile=/etc/neo-tunnel/secrets/proxy.env
ExecStartPre=/usr/local/bin/caddy-forwardproxy validate --config /etc/neo-tunnel/Caddyfile --adapter caddyfile
ExecStart=/usr/local/bin/caddy-forwardproxy run --config /etc/neo-tunnel/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Restart=on-failure
