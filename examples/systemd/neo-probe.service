[Unit]
Description=NEO tunnel application canary

[Service]
Type=simple
Slice=neo.slice
User=neo
Group=neo
ExecStart=/usr/local/bin/backhaul-probe serve -listen 127.0.0.1:18080
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
